# MA GIÁO ONLINE – THIÊN HẠ ĐỆ NHẤT TÀ PHÁI
# Sao chép file này thành .env khi chạy cục bộ trên Mac / Windows

# Khóa Gemini API (Tuỳ chọn cho sinh câu thoại dự phòng)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Microsoft Azure AI Speech (Giọng Nam Minh / Hoài My)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="southeastasia"

# VieNeu TTS (Cloud hoặc Local 127.0.0.1:8000)
VIENEU_API_KEY=""
VIENEU_TTS_URL="https://api.vieneu.io/api/v1/audio/speech"
VIENEU_LOCAL_URL="http://127.0.0.1:8000/v1/audio/speech"
ALLOW_LOCAL_MAC_TTS="false"

# TikTok LIVE Sign API Key (Tuỳ chọn mở rộng cho tiktok-live-connector)
TIKTOK_SIGN_API_KEY=""

# Mã bảo vệ trang Quản trị Admin (Để trống khi chạy cục bộ trên máy cá nhân)
ADMIN_ACCESS_TOKEN=""
